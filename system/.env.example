# Java properties 语法：不要给值加引号；Windows 路径用 /。
# 复制为 .env 后填写本机信息；进程环境变量优先于此文件。
SPRING_PROFILES_ACTIVE=dev
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gc_system
DB_USERNAME=gc_system
DB_PASSWORD=
# 仅本机开发可关闭 TLS，或允许 MySQL 8 公钥检索。
DB_USE_SSL=false
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false
# 可用完整 JDBC URL 覆盖上面的主机/端口/数据库设置。
# DB_URL=jdbc:mysql://127.0.0.1:3306/gc_system?sslMode=VERIFY_IDENTITY&serverTimezone=Asia%2FShanghai
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=6
REDIS_PASSWORD=
# 填入至少 64 字节随机数据的 Base64 值，用于若依 HS512 签名。
TOKEN_SECRET=
TOKEN_EXPIRE_MINUTES=30
UPLOAD_PATH=./data/uploads
LOG_PATH=./logs
LOG_LEVEL=info
API_DOCS_ENABLED=true

# gameshop：与后台 TOKEN_SECRET 不同，分别生成至少 48 字符随机值
GAMESHOP_MEMBER_SECRET=replace-with-independent-random-secret-at-least-48-characters
GAMESHOP_CODE_SECRET=replace-with-another-independent-random-secret-at-least-48-characters
GAMESHOP_CAPTCHA_ENABLED=true
# 默认不要求注册邮箱验证码；关闭时邮箱发码及邮箱找回密码不可用，图形码仍生效
GAMESHOP_EMAIL_VERIFICATION_ENABLED=false
# file 仅 dev 可用，邮件写入 data/test-mailbox，HTTP 不返回验证码；生产改 smtp
GAMESHOP_MAIL_MODE=file
GAMESHOP_MAILBOX_PATH=./data/test-mailbox
# SMTP 模式填写；前端不得复制这些变量
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
