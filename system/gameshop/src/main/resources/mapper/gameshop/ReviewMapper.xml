<select id="findReview" resultMap="ReviewEntity">SELECT * FROM mall_review WHERE review_id=#{id}</select>
<select id="lockReview" resultMap="ReviewEntity">SELECT * FROM mall_review WHERE review_id=#{id} FOR UPDATE</select>
<insert id="insertReview" useGeneratedKeys="true" keyProperty="reviewId">INSERT INTO mall_review (`member_id`,`order_id`,`order_item_id`,`prop_id`,`score`,`content`,`status`,`hide_reason`,`hidden_by`,`hidden_time`) VALUES (#{memberId},#{orderId},#{orderItemId},#{propId},#{score},#{content},#{status},#{hideReason},#{hiddenBy},#{hiddenTime})</insert>
<select id="byItem" resultMap="ReviewEntity">SELECT * FROM mall_review WHERE order_item_id=#{id}</select>
<update id="hide">UPDATE mall_review SET status='HIDDEN',hide_reason=#{hideReason},hidden_by=#{hiddenBy},hidden_time=#{hiddenTime} WHERE review_id=#{reviewId} AND status='VISIBLE'</update>
<select id="countVisible" resultType="long">SELECT COUNT(*) FROM mall_review WHERE prop_id=#{id} AND status='VISIBLE'</select>
<select id="averageScore" resultType="double">SELECT COALESCE(AVG(score),0) FROM mall_review WHERE prop_id=#{id} AND status='VISIBLE'</select>
<select id="listReview" resultMap="ReviewEntity">SELECT * FROM mall_review <where><if test="memberId != null">AND `member_id`=#{memberId}</if> <if test="propId != null">AND `prop_id`=#{propId}</if> <if test="status != null">AND `status`=#{status}</if> <if test="createdFrom != null">AND create_time &gt;= #{createdFrom}</if> <if test="createdTo != null">AND create_time &lt; #{createdTo}</if> <if test="publicOnly">AND status='VISIBLE'</if></where> ORDER BY create_time DESC,review_id DESC LIMIT #{limit} OFFSET #{offset}</select>
<select id="countReview" resultType="long">SELECT COUNT(*) FROM mall_review <where><if test="memberId != null">AND `member_id`=#{memberId}</if> <if test="propId != null">AND `prop_id`=#{propId}</if> <if test="status != null">AND `status`=#{status}</if> <if test="createdFrom != null">AND create_time &gt;= #{createdFrom}</if> <if test="createdTo != null">AND create_time &lt; #{createdTo}</if> <if test="publicOnly">AND status='VISIBLE'</if></where></select>
