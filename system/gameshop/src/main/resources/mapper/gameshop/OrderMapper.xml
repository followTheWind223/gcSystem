<select id="findOrder" resultMap="OrderEntity">SELECT * FROM mall_order WHERE order_id=#{id}</select>
<select id="lockOrder" resultMap="OrderEntity">SELECT * FROM mall_order WHERE order_id=#{id} FOR UPDATE</select>
<insert id="insertOrder" useGeneratedKeys="true" keyProperty="orderId">INSERT INTO mall_order (`order_no`,`member_id`,`source`,`request_key`,`request_hash`,`total_amount`,`total_quantity`,`item_count`,`currency`,`status`,`delivery_info_json`,`remark`,`cancel_reason`,`expire_time`,`paid_time`,`cancelled_time`,`completed_time`) VALUES (#{orderNo},#{memberId},#{source},#{requestKey},#{requestHash},#{totalAmount},#{totalQuantity},#{itemCount},#{currency},#{status},#{deliveryInfoJson},#{remark},#{cancelReason},#{expireTime},#{paidTime},#{cancelledTime},#{completedTime})</insert>
<select id="findOrderItem" resultMap="OrderItemEntity">SELECT * FROM mall_order_item WHERE order_item_id=#{id}</select>
<select id="lockOrderItem" resultMap="OrderItemEntity">SELECT * FROM mall_order_item WHERE order_item_id=#{id} FOR UPDATE</select>
<insert id="insertOrderItem" useGeneratedKeys="true" keyProperty="orderItemId">INSERT INTO mall_order_item (`order_id`,`prop_id`,`prop_name`,`cover_url`,`spec_json`,`unit_price`,`quantity`) VALUES (#{orderId},#{propId},#{propName},#{coverUrl},#{specJson},#{unitPrice},#{quantity})</insert>
<select id="findPaymentRecord" resultMap="PaymentRecordEntity">SELECT * FROM mall_payment_record WHERE payment_id=#{id}</select>
<select id="lockPaymentRecord" resultMap="PaymentRecordEntity">SELECT * FROM mall_payment_record WHERE payment_id=#{id} FOR UPDATE</select>
<insert id="insertPaymentRecord" useGeneratedKeys="true" keyProperty="paymentId">INSERT INTO mall_payment_record (`order_id`,`payment_no`,`channel`,`amount`,`paid_time`) VALUES (#{orderId},#{paymentNo},#{channel},#{amount},#{paidTime})</insert>
<select id="findOrderDelivery" resultMap="OrderDeliveryEntity">SELECT * FROM mall_order_delivery WHERE delivery_id=#{id}</select>
<select id="lockOrderDelivery" resultMap="OrderDeliveryEntity">SELECT * FROM mall_order_delivery WHERE delivery_id=#{id} FOR UPDATE</select>
<insert id="insertOrderDelivery" useGeneratedKeys="true" keyProperty="deliveryId">INSERT INTO mall_order_delivery (`order_id`,`delivery_note`,`operator_admin_id`,`operator_name`,`delivered_time`) VALUES (#{orderId},#{deliveryNote},#{operatorAdminId},#{operatorName},#{deliveredTime})</insert>
<select id="findOrderLog" resultMap="OrderLogEntity">SELECT * FROM mall_order_log WHERE log_id=#{id}</select>
<select id="lockOrderLog" resultMap="OrderLogEntity">SELECT * FROM mall_order_log WHERE log_id=#{id} FOR UPDATE</select>
<insert id="insertOrderLog" useGeneratedKeys="true" keyProperty="logId">INSERT INTO mall_order_log (`order_id`,`from_status`,`to_status`,`operator_type`,`operator_id`,`operator_name`,`reason`) VALUES (#{orderId},#{fromStatus},#{toStatus},#{operatorType},#{operatorId},#{operatorName},#{reason})</insert>
<select id="findStockLog" resultMap="StockLogEntity">SELECT * FROM mall_stock_log WHERE stock_log_id=#{id}</select>
<select id="lockStockLog" resultMap="StockLogEntity">SELECT * FROM mall_stock_log WHERE stock_log_id=#{id} FOR UPDATE</select>
<insert id="insertStockLog" useGeneratedKeys="true" keyProperty="stockLogId">INSERT INTO mall_stock_log (`prop_id`,`prop_name`,`change_qty`,`before_stock`,`after_stock`,`biz_type`,`biz_key`,`request_hash`,`order_id`,`operator_type`,`operator_id`,`operator_name`,`reason`) VALUES (#{propId},#{propName},#{changeQty},#{beforeStock},#{afterStock},#{bizType},#{bizKey},#{requestHash},#{orderId},#{operatorType},#{operatorId},#{operatorName},#{reason})</insert>
<select id="byNumber" resultMap="OrderEntity">SELECT * FROM mall_order WHERE order_no=#{number}</select>
<select id="byRequest" resultMap="OrderEntity">SELECT * FROM mall_order WHERE member_id=#{memberId} AND request_key=#{key}</select>
<select id="items" resultMap="OrderItemEntity">SELECT * FROM mall_order_item WHERE order_id=#{id} ORDER BY order_item_id</select>
<select id="payment" resultMap="PaymentRecordEntity">SELECT * FROM mall_payment_record WHERE order_id=#{id}</select>
<select id="delivery" resultMap="OrderDeliveryEntity">SELECT * FROM mall_order_delivery WHERE order_id=#{id}</select>
<select id="logs" resultMap="OrderLogEntity">SELECT * FROM mall_order_log WHERE order_id=#{id} ORDER BY create_time,log_id</select>
<select id="stockByKey" resultMap="StockLogEntity">SELECT * FROM mall_stock_log WHERE prop_id=#{propId} AND biz_type=#{type} AND biz_key=#{key}</select>
<update id="transition">UPDATE mall_order SET status=#{row.status},paid_time=#{row.paidTime},cancelled_time=#{row.cancelledTime},completed_time=#{row.completedTime},cancel_reason=#{row.cancelReason} WHERE order_id=#{row.orderId} AND status=#{old}</update>
<select id="expiredIds" resultType="long">SELECT order_id FROM mall_order WHERE status='1' AND expire_time&lt;=CURRENT_TIMESTAMP(3) ORDER BY expire_time,order_id LIMIT 100</select>
<select id="listOrder" resultMap="OrderEntity">SELECT * FROM mall_order <where><if test="memberId != null">AND `member_id`=#{memberId}</if> <if test="status != null">AND `status`=#{status}</if> <if test="orderNo != null">AND `order_no`=#{orderNo}</if> <if test="createdFrom != null">AND create_time &gt;= #{createdFrom}</if> <if test="createdTo != null">AND create_time &lt; #{createdTo}</if></where> ORDER BY create_time DESC,order_id DESC LIMIT #{limit} OFFSET #{offset}</select>
<select id="countOrder" resultType="long">SELECT COUNT(*) FROM mall_order <where><if test="memberId != null">AND `member_id`=#{memberId}</if> <if test="status != null">AND `status`=#{status}</if> <if test="orderNo != null">AND `order_no`=#{orderNo}</if> <if test="createdFrom != null">AND create_time &gt;= #{createdFrom}</if> <if test="createdTo != null">AND create_time &lt; #{createdTo}</if></where></select>
<select id="listStockLog" resultMap="StockLogEntity">SELECT * FROM mall_stock_log <where><if test="propId != null">AND `prop_id`=#{propId}</if> <if test="bizType != null">AND `biz_type`=#{bizType}</if> <if test="createdFrom != null">AND create_time &gt;= #{createdFrom}</if> <if test="createdTo != null">AND create_time &lt; #{createdTo}</if></where> ORDER BY create_time DESC,stock_log_id DESC LIMIT #{limit} OFFSET #{offset}</select>
<select id="countStockLog" resultType="long">SELECT COUNT(*) FROM mall_stock_log <where><if test="propId != null">AND `prop_id`=#{propId}</if> <if test="bizType != null">AND `biz_type`=#{bizType}</if> <if test="createdFrom != null">AND create_time &gt;= #{createdFrom}</if> <if test="createdTo != null">AND create_time &lt; #{createdTo}</if></where></select>
<select id="pendingQuantity" resultType="long">SELECT COALESCE(SUM(i.quantity),0) FROM mall_order_item i JOIN mall_order o ON o.order_id=i.order_id WHERE i.prop_id=#{propId} AND o.status='1'</select>
</mapper>
