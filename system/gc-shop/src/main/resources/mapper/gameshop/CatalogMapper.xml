<update id="changeStock">UPDATE mall_prop SET stock=stock+#{delta},version=version+1 WHERE prop_id=#{id} AND stock+#{delta} BETWEEN 0 AND 1000000000</update>
<update id="addSales">UPDATE mall_prop SET sales=sales+#{quantity},version=version+1 WHERE prop_id=#{id} AND sales+#{quantity}&lt;=2147483647</update>
