<select id="listProp" resultMap="PropEntity">SELECT * FROM mall_prop <where>AND del_flag='0' <if test="categoryId != null">AND `category_id`=#{categoryId}</if> <if test="propId != null">AND `prop_id`=#{propId}</if> <if test="status != null">AND `status`=#{status}</if> <if test="keyword != null">AND `name` LIKE CONCAT('%',#{keyword},'%')</if> <if test="createdFrom != null">AND create_time &gt;= #{createdFrom}</if> <if test="createdTo != null">AND create_time &lt; #{createdTo}</if> <if test="publicOnly">AND status='1' AND EXISTS(SELECT 1 FROM mall_game_category c WHERE c.category_id=mall_prop.category_id AND c.status='1' AND c.del_flag='0')</if> <if test="minPrice != null">AND price&gt;=#{minPrice}</if> <if test="maxPrice != null">AND price&lt;=#{maxPrice}</if></where> <choose><when test="sort == 'sales_desc'">ORDER BY sales DESC,prop_id DESC</when><when test="sort == 'price_asc'">ORDER BY price,prop_id DESC</when><when test="sort == 'price_desc'">ORDER BY price DESC,prop_id DESC</when><otherwise>ORDER BY on_sale_time DESC,prop_id DESC</otherwise></choose> LIMIT #{limit} OFFSET #{offset}</select>
<select id="countProp" resultType="long">SELECT COUNT(*) FROM mall_prop <where>AND del_flag='0' <if test="categoryId != null">AND `category_id`=#{categoryId}</if> <if test="propId != null">AND `prop_id`=#{propId}</if> <if test="status != null">AND `status`=#{status}</if> <if test="keyword != null">AND `name` LIKE CONCAT('%',#{keyword},'%')</if> <if test="createdFrom != null">AND create_time &gt;= #{createdFrom}</if> <if test="createdTo != null">AND create_time &lt; #{createdTo}</if> <if test="publicOnly">AND status='1' AND EXISTS(SELECT 1 FROM mall_game_category c WHERE c.category_id=mall_prop.category_id AND c.status='1' AND c.del_flag='0')</if> <if test="minPrice != null">AND price&gt;=#{minPrice}</if> <if test="maxPrice != null">AND price&lt;=#{maxPrice}</if></where></select>
