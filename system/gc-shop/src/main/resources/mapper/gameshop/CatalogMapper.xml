<update id="updateGameCategory">UPDATE mall_game_category SET `name`=#{name},`icon_media_id`=#{iconMediaId},`sort`=#{sort},`status`=#{status},`recommended`=#{recommended},`update_by`=#{updateBy},version=version+1 WHERE category_id=#{categoryId} AND version=#{version} AND del_flag='0'</update>
