<select id="listGameCategory" resultMap="GameCategoryEntity">SELECT * FROM mall_game_category <where>AND del_flag='0' <if test="categoryId != null">AND `category_id`=#{categoryId}</if> <if test="status != null">AND `status`=#{status}</if> <if test="keyword != null">AND `name` LIKE CONCAT('%',#{keyword},'%')</if> <if test="createdFrom != null">AND create_time &gt;= #{createdFrom}</if> <if test="createdTo != null">AND create_time &lt; #{createdTo}</if> <if test="publicOnly">AND status='1'</if></where> ORDER BY sort,category_id LIMIT #{limit} OFFSET #{offset}</select>
