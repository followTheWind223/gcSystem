<select id="bySysUserId" resultMap="MemberEntity">SELECT * FROM mall_member WHERE sys_user_id=#{userId}</select>
<select id="lockMemberBySysUserId" resultMap="MemberEntity">SELECT * FROM mall_member WHERE sys_user_id=#{userId} FOR UPDATE</select>
<select id="lockSysUser" resultType="long">SELECT user_id FROM sys_user WHERE user_id=#{userId} FOR UPDATE</select>
<select id="findMember" resultMap="MemberEntity">SELECT * FROM mall_member WHERE member_id=#{id}</select>
<select id="lockMember" resultMap="MemberEntity">SELECT * FROM mall_member WHERE member_id=#{id} FOR UPDATE</select>
<insert id="insertMember" useGeneratedKeys="true" keyProperty="memberId">INSERT INTO mall_member (`sys_user_id`,`username`,`password_hash`,`nickname`,`avatar_media_id`,`email`,`email_verified`,`phone_number`,`status`,`session_version`,`status_reason`,`last_login_time`) VALUES (#{sysUserId},#{username},#{passwordHash},#{nickname},#{avatarMediaId},#{email},#{emailVerified},#{phoneNumber},#{status},#{sessionVersion},#{statusReason},#{lastLoginTime})</insert>
<select id="byUsername" resultMap="MemberEntity">SELECT * FROM mall_member WHERE username=#{username}</select>
<select id="byEmail" resultMap="MemberEntity">SELECT * FROM mall_member WHERE email=#{email}</select>
<update id="updateProfile">UPDATE mall_member SET nickname=#{nickname},phone_number=#{phoneNumber} WHERE member_id=#{memberId}</update>
<update id="updateAvatar">UPDATE mall_member SET avatar_media_id=#{avatarMediaId} WHERE member_id=#{memberId}</update>
<update id="changePassword">UPDATE mall_member SET password_hash=#{passwordHash},session_version=session_version+1 WHERE member_id=#{memberId}</update>
<update id="setStatus">UPDATE mall_member SET status=#{status},status_reason=#{statusReason},session_version=session_version+1 WHERE member_id=#{memberId}</update>
<update id="recordLogin">UPDATE mall_member SET last_login_time=CURRENT_TIMESTAMP(3) WHERE member_id=#{id}</update>
<select id="listMember" resultMap="MemberEntity">SELECT * FROM mall_member <where><if test="memberId != null">AND `member_id`=#{memberId}</if> <if test="status != null">AND `status`=#{status}</if> <if test="keyword != null">AND (username LIKE CONCAT('%',#{keyword},'%') OR nickname LIKE CONCAT('%',#{keyword},'%'))</if> <if test="createdFrom != null">AND create_time &gt;= #{createdFrom}</if> <if test="createdTo != null">AND create_time &lt; #{createdTo}</if></where> ORDER BY create_time DESC,member_id DESC LIMIT #{limit} OFFSET #{offset}</select>
<select id="countMember" resultType="long">SELECT COUNT(*) FROM mall_member <where><if test="memberId != null">AND `member_id`=#{memberId}</if> <if test="status != null">AND `status`=#{status}</if> <if test="keyword != null">AND (username LIKE CONCAT('%',#{keyword},'%') OR nickname LIKE CONCAT('%',#{keyword},'%'))</if> <if test="createdFrom != null">AND create_time &gt;= #{createdFrom}</if> <if test="createdTo != null">AND create_time &lt; #{createdTo}</if></where></select>
