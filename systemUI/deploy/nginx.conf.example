# 静态资源部署示例：修改 server_name、证书和 root 后使用。
# /api/mall/ 的 proxy_pass 不加末尾斜杠，保留完整商城前缀。
server {
    listen 80;
    server_name mall.example.com;
    root /srv/gc-system/systemUI/dist;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    client_max_body_size 3m;
    # 若依原生认证接口；去掉代理前缀，避免 /login 与 SPA 登录路由冲突。
    location /api/auth/ {
        proxy_pass http://127.0.0.1:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /api/mall/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }
    location /images/ {
        try_files $uri =404;
        expires 7d;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
# 对公网部署时配置 HTTPS；本文件仅示范 SPA 回退和同源代理，未进行 Nginx 实机验收。
